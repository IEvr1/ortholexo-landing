# Frontend (public at build time)
VITE_SITE_URL=https://ortholexo.gr
VITE_APP_URL=https://app.ortholexo.gr

# Contact form API (server-only — set in Vercel, not exposed to browser)
# Use the Resend key for the verified domain mail.nexaipla.com
RESEND_API_KEY=
CONTACT_TO=contact@nexaipla.com
CONTACT_FROM=Ορθόλεξο <contact@mail.nexaipla.com>

# EmailMarketing pipeline (form → pending_questions → /replies)
# Same secret as CONTACT_INGEST_SECRET or CRON_SECRET on EmailMarketing
EMAIL_MARKETING_URL=https://marketing.ortholexo.gr
EMAIL_MARKETING_HOOK_SECRET=
EMAIL_MARKETING_PRODUCT_SLUG=ortholexo
